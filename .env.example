# NEXUS AI - Lesson 01 environment
# Copy this file to .env (or run: node scripts/init-env.mjs) and never commit .env.

# --- Ports on your machine -------------------------------------------------
# Change these only if something else already uses the port.
NEXUS_WEB_PORT=3100
NEXUS_API_PORT=8100
NEXUS_DB_PORT=5433
CHATWOOT_PORT=3110

# --- NEXUS database (application data and integration state) ----------------
NEXUS_DB_USER=nexus
NEXUS_DB_PASSWORD=
NEXUS_DB_NAME=nexus

# --- Chatwoot service (it keeps its own Postgres and Redis) -----------------
# Long random strings. scripts/init-env.mjs generates them for you.
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_POSTGRES_PASSWORD=
CHATWOOT_REDIS_PASSWORD=

# warn (default) or info. info is useful for debugging webhooks, but it prints
# the webhook secret in the worker's logs.
CHATWOOT_LOG_LEVEL=warn

# --- Chatwoot integration (filled in during the lesson) ---------------------
# Account id: shown in the Chatwoot URL, /app/accounts/<id>/...
CHATWOOT_ACCOUNT_ID=1
# Profile Settings -> Access Token. Server-side only, never sent to the browser.
CHATWOOT_API_TOKEN=
# Printed by: docker compose exec backend python -m app.cli chatwoot-setup
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_INBOX_IDENTIFIER=

# Reject webhooks whose signed timestamp is older than this many seconds.
WEBHOOK_MAX_AGE_SECONDS=300

# --- Optional: Meta app for Facebook Messenger / Instagram channels ----------
# From developers.facebook.com > your app > App settings > Basic.
# The verify tokens are any random strings; you paste the same value into
# Meta's webhook settings.
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
IG_VERIFY_TOKEN=

# --- Optional: a note of your local Chatwoot login ---------------------------
# NEXUS does not read these. They are only a place to keep the test login you
# create on the Chatwoot onboarding screen.
# CHATWOOT_ADMIN_EMAIL=
# CHATWOOT_ADMIN_PASSWORD=
